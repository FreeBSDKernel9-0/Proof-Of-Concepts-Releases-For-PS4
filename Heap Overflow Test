<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Heap Overflow Vulnerability Education</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 20px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            padding: 30px 0;
            margin-bottom: 30px;
        }
        
        h1 {
            font-size: 2.8rem;
            color: #2c3e50;
            margin-bottom: 15px;
        }
        
        h2 {
            font-size: 2rem;
            color: #3498db;
            margin: 25px 0 15px;
            border-bottom: 2px solid #3498db;
            padding-bottom: 8px;
        }
        
        h3 {
            font-size: 1.5rem;
            color: #2c3e50;
            margin: 20px 0 10px;
        }
        
        p {
            margin-bottom: 15px;
            font-size: 1.1rem;
        }
        
        .warning {
            background-color: #ffeaa7;
            border-left: 5px solid #fdcb6e;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        
        .info-box {
            background-color: #d6eaf8;
            border-left: 5px solid #3498db;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        
        .code-block {
            background-color: #2d3436;
            color: #dfe6e9;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
            overflow-x: auto;
            font-family: 'Courier New', monospace;
        }
        
        .visualization {
            background: white;
            border-radius: 8px;
            padding: 20px;
            margin: 30px 0;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
        
        .memory-block {
            display: flex;
            margin: 15px 0;
            flex-wrap: wrap;
        }
        
        .memory-cell {
            width: 120px;
            height: 60px;
            border: 1px solid #3498db;
            margin: 5px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: #e8f4fc;
            transition: all 0.3s ease;
            border-radius: 4px;
        }
        
        .memory-cell.overflow {
            background: #ff7675;
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0% { background-color: #ff7675; }
            50% { background-color: #ff9e9d; }
            100% { background-color: #ff7675; }
        }
        
        .btn {
            display: inline-block;
            background: #3498db;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            font-size: 16px;
            margin: 10px 5px;
            transition: background 0.3s ease;
        }
        
        .btn:hover {
            background: #2980b9;
        }
        
        .btn.danger {
            background: #e74c3c;
        }
        
        .btn.danger:hover {
            background: #c0392b;
        }
        
        footer {
            text-align: center;
            margin-top: 50px;
            padding: 20px;
            color: #7f8c8d;
            font-size: 0.9rem;
        }
        
        .tab-container {
            margin: 30px 0;
        }
        
        .tab-buttons {
            display: flex;
            margin-bottom: -1px;
        }
        
        .tab-btn {
            padding: 12px 24px;
            background: #dfe6e9;
            border: 1px solid #b2bec3;
            cursor: pointer;
            font-weight: bold;
            border-top-left-radius: 5px;
            border-top-right-radius: 5px;
            margin-right: 5px;
        }
        
        .tab-btn.active {
            background: white;
            border-bottom: 1px solid white;
        }
        
        .tab-content {
            display: none;
            padding: 20px;
            background: white;
            border: 1px solid #b2bec3;
            border-radius: 0 5px 5px 5px;
        }
        
        .tab-content.active {
            display: block;
        }
        
        @media (max-width: 768px) {
            h1 {
                font-size: 2.2rem;
            }
            
            h2 {
                font-size: 1.8rem;
            }
            
            .memory-cell {
                width: 100px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>Heap Overflow Vulnerabilities</h1>
            <p>Understanding, preventing, and mitigating heap-based buffer overflow attacks</p>
        </header>
        
        <div class="warning">
            <strong>Warning:</strong> This is an educational resource only. Never attempt to exploit vulnerabilities on systems without explicit permission.
        </div>
        
        <h2>What is a Heap Overflow?</h2>
        <p>A heap overflow is a type of buffer overflow that occurs in the heap data area. Heap overflows are exploitation techniques that target data stored in memory allocated dynamically at runtime.</p>
        
        <div class="info-box">
            <p>Unlike stack overflows, heap overflows can be more difficult to exploit but can lead to arbitrary code execution, privilege escalation, or service disruption.</p>
        </div>
        
        <h2>How Heap Overflows Work</h2>
        <p>Heap overflows occur when a program writes more data to a heap-allocated buffer than it can hold. The excess data overwrites adjacent memory structures, which can include:</p>
        <ul>
            <li>Other heap allocations</li>
            <li>Heap management data</li>
            <li>Function pointers</li>
            <li>Application data structures</li>
        </ul>
        
        <div class="visualization">
            <h3>Heap Memory Visualization</h3>
            <p>Below is a simplified representation of heap memory. Try overflowing the buffer to see what happens:</p>
            
            <div class="memory-block">
                <div class="memory-cell">
                    <span>Buffer A</span>
                    <small>16 bytes</small>
                </div>
                <div class="memory-cell">
                    <span>Buffer B</span>
                    <small>16 bytes</small>
                </div>
                <div class="memory-cell">
                    <span>Important Data</span>
                    <small>8 bytes</small>
                </div>
            </div>
            
            <div style="margin: 20px 0;">
                <input type="text" id="inputBuffer" placeholder="Enter more than 16 characters" style="padding: 10px; width: 300px; border-radius: 4px; border: 1px solid #b2bec3;">
                <button class="btn" onclick="simulateOverflow()">Write to Buffer</button>
                <button class="btn danger" onclick="resetVisualization()">Reset</button>
            </div>
            
            <div id="visualizationResult"></div>
        </div>
        
        <h2>Common Causes of Heap Overflows</h2>
        <div class="tab-container">
            <div class="tab-buttons">
                <div class="tab-btn active" onclick="openTab(event, 'tab1')">Unbounded Copies</div>
                <div class="tab-btn" onclick="openTab(event, 'tab2')">Integer Overflows</div>
                <div class="tab-btn" onclick="openTab(event, 'tab3')">Off-by-One Errors</div>
            </div>
            
            <div id="tab1" class="tab-content active">
                <h3>Unbounded Copies</h3>
                <p>Using unsafe functions like <code>strcpy</code>, <code>strcat</code>, or <code>sprintf</code> without proper bounds checking can lead to heap overflows.</p>
                <div class="code-block">
                    // Vulnerable code example<br>
                    char *buffer = malloc(16);<br>
                    strcpy(buffer, user_input);  // If user_input > 16 bytes, overflow occurs
                </div>
            </div>
            
            <div id="tab2" class="tab-content">
                <h3>Integer Overflows</h3>
                <p>When integer calculations for buffer sizes wrap around, they can result in allocating smaller buffers than intended.</p>
                <div class="code-block">
                    // Vulnerable code example<br>
                    size_t size = requested_size + 10; // If requested_size is very large, this could wrap around<br>
                    char *buffer = malloc(size);<br>
                    // Buffer might be smaller than expected
                </div>
            </div>
            
            <div id="tab3" class="tab-content">
                <h3>Off-by-One Errors</h3>
                <p>Writing one byte beyond the allocated buffer can corrupt heap metadata and lead to exploitation.</p>
                <div class="code-block">
                    // Vulnerable code example<br>
                    char *buffer = malloc(16);<br>
                    for (int i = 0; i <= 16; i++) {  // Goes one byte too far<br>
                    &nbsp;&nbsp;&nbsp;&nbsp;buffer[i] = 'A';<br>
                    }
                </div>
            </div>
        </div>
        
        <h2>Prevention Techniques</h2>
        <p>Protecting against heap overflows requires a multi-layered approach:</p>
        <ul>
            <li>Use safe programming practices and secure functions (<code>strncpy</code>, <code>snprintf</code>)</li>
            <li>Implement proper input validation and bounds checking</li>
            <li>Use modern heap allocators with built-in protections (e.g., glibc's malloc hardening)</li>
            <li>Employ compiler protections (ASLR, stack canaries, DEP)</li>
            <li>Perform regular code reviews and security testing</li>
        </ul>
        
        <div class="info-box">
            <p>Modern operating systems include protections like Address Space Layout Randomization (ASLR) and Data Execution Prevention (DEP) that make heap overflow exploitation more difficult.</p>
        </div>
        
        <h2>Further Learning</h2>
        <p>To learn more about heap overflows and secure coding practices:</p>
        <ul>
            <li>Read OWASP guidelines on buffer overflow prevention</li>
            <li>Study secure coding standards for C/C++</li>
            <li>Experiment with capture-the-flag challenges in controlled environments</li>
            <li>Review CWE-122: Heap-based Buffer Overflow</li>
        </ul>
        
        <footer>
            <p>This educational resource is for security awareness only. Always practice ethical hacking principles.</p>
            <p>© 2023 Cybersecurity Education</p>
        </footer>
    </div>

    <script>
        function simulateOverflow() {
            const input = document.getElementById('inputBuffer').value;
            const resultDiv = document.getElementById('visualizationResult');
            const memoryCells = document.querySelectorAll('.memory-cell');
            
            if (input.length <= 16) {
                resultDiv.innerHTML = '<div class="info-box">Data written successfully to Buffer A (no overflow).</div>';
                memoryCells[0].textContent = `Buffer A: "${input}"`;
                memoryCells[0].classList.remove('overflow');
            } else {
                resultDiv.innerHTML = '<div class="warning">Heap overflow detected! Data has overwritten adjacent memory.</div>';
                memoryCells[0].textContent = `Buffer A: "${input.substring(0, 16)}"`;
                memoryCells[0].classList.add('overflow');
                
                // Show overflow into next buffer
                if (input.length > 16) {
                    const overflowData = input.substring(16, 32);
                    memoryCells[1].textContent = `Buffer B: "${overflowData}"`;
                    memoryCells[1].classList.add('overflow');
                }
                
                if (input.length > 32) {
                    const criticalOverflow = input.substring(32, 40);
                    memoryCells[2].textContent = `Important Data: "${criticalOverflow}"`;
                    memoryCells[2].classList.add('overflow');
                    resultDiv.innerHTML += '<div class="warning">Critical memory corruption! This could lead to arbitrary code execution.</div>';
                }
            }
        }
        
        function resetVisualization() {
            document.getElementById('inputBuffer').value = '';
            document.getElementById('visualizationResult').innerHTML = '';
            
            const memoryCells = document.querySelectorAll('.memory-cell');
            memoryCells[0].textContent = 'Buffer A\n16 bytes';
            memoryCells[1].textContent = 'Buffer B\n16 bytes';
            memoryCells[2].textContent = 'Important Data\n8 bytes';
            
            memoryCells.forEach(cell => {
                cell.classList.remove('overflow');
            });
        }
        
        function openTab(evt, tabId) {
            // Hide all tab content
            const tabContent = document.getElementsByClassName('tab-content');
            for (let i = 0; i < tabContent.length; i++) {
                tabContent[i].classList.remove('active');
            }
            
            // Remove active class from all buttons
            const tabButtons = document.getElementsByClassName('tab-btn');
            for (let i = 0; i < tabButtons.length; i++) {
                tabButtons[i].classList.remove('active');
            }
            
            // Show the specific tab content
            document.getElementById(tabId).classList.add('active');
            evt.currentTarget.classList.add('active');
        }
    </script>
</body>
</html>